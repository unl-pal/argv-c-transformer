# Downloader.py's own config for docs/tutorial/Tutorial.md - entirely
# separate from tutorial.config, which the filter/transform/verify pipeline
# reads. See src/download/downloader.config for the CSV-index-driven
# default; this one instead names a single repo directly.
#
# Run `python3 src/download/Downloader.py docs/tutorial/download.config`
# from the repo root.

[File Locations]
# Must match tutorial.config's databaseDir, since filter reads from there.
databaseDir=docs/tutorial/source-files

[Downloader]
# A single "owner/name" repo, bypassing the CSV-index flow entirely (see
# Downloader.py's `repo` setting). Good for a known, deliberately-chosen
# repo like this tutorial's toy example.
repo=natsteven/argc-example
