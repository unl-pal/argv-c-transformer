# Config used by docs/tutorial/Tutorial.md - filters, transforms, and
# verifies the toy repo at https://github.com/natsteven/argc-example, once
# docs/tutorial/download.config has populated databaseDir. Read by
# filter/transform/verify/argv-c only; Downloader.py reads its own separate
# config (see download.config), since it's a standalone step never invoked
# by the C++ pipeline.
#
# Run every command in the tutorial from the argv-c-transformer repo root;
# all paths below are relative to that root. See settings.config at the
# repo root for the full set of available options.

[Stage Directories]
databaseDir=docs/tutorial/source-files
filterDir=docs/tutorial/filtered-files
transformDir=docs/tutorial/transformed-files
benchmarkDir=docs/tutorial/benchmark-files

[Complexity Requirements]
# A function needs at least one for-loop to survive filtering. This is the
# only threshold set here - enough to split argc-example's three functions
# into "removed" and "kept" buckets.
ForLoops = 1,9999

[File Settings]
FileLoC=1,9999
keepCompilesOnly=true
debugLevel=1
