# ARG-V pipeline configuration.
#
# One file feeds all the tools:
#   - Downloader.py reads [File Locations], [Downloading], and [Filters]
#     (sections matter)
#   - filter / transform / full match keys by name anywhere in the file;
#     for them the section headers are organizational only
#
# Commented-out keys document the remaining available options and show their
# built-in defaults.

[File Locations]
csv=dataset.csv # Downloader.py only: CSV listing repos
databaseDir=repos # also used by Downloader.py as the download destination
# filterDir=repos-filtered # filter output / transform input
# transformDir=repos-transformed # transform output / verify input
# benchmarkDir=repos-benchmarks # benchmark output including *.yml files

[Downloading]
# Downloader.py only
projectCount = 15

[Filters]
# Downloader.py only. Each key must match a column in the CSV named by
# [File Locations].csv; unknown keys abort the download. A value that
# parses as a number is treated as a MINIMUM (row's column value must be
# >=); otherwise it's a SELECTION (comma-separated list of acceptable
# exact-match values, e.g. `language = C,C++`).
language = C
stars = 0
size = 100

[Complexity Requirements]
# Filter-step thresholds, applied per function (main is not exempt from
# these). A function whose count falls outside `min,max` for any metric is
# removed and calls to it are replaced with __VERIFIER_nondet_*. Unset
# metrics default to 0,9999, i.e. no filtering. Values are either
# `min,max`, 'min', or ',max'
#
# The verify step re-applies the same thresholds to the transformed source
# (havocking can shrink a function below limits it originally met); a
# function failing there is stripped and unharnessed from the generated
# main. The generated main and __VERIFIER_*/__havoc_* helpers are exempt,
# and __VERIFIER_nondet_* calls never count toward CallFunc.
#
#   ForLoops   — for-loop count
#   WhileLoops — while-loop count
#   IfStmt     — if-statement count
#   CallFunc   — calls made by the function
#   Param      — parameter count
ForLoops = 0,9999

[Feature Requirements]
# Filter-step gates, applied per function. Each feature is a presence flag
# Value is one of: ignore | require | forbid.
# Unset features default to ignore.
#
#   Concurrency   — uses a concurrency-related type/call (e.g. pthread_*)
#   FloatingPoint — uses float/double anywhere (param, local, or return type)
Concurrency = ignore
FloatingPoint = ignore

[File Requirements and Settings]
# File-level pre-filter on non-empty line count (filter step)
minFileLoC=5
maxFileLoC=9999

[Debugging Flags]
# 0 = silent, 1 = high-priority messages, 2 = +per-file detail, 3 = everything
debugLevel=1
