# Downloader.py's own config - entirely separate from settings.config,
# which the filter/transform/verify/argv-c pipeline reads. Downloader.py
# doesn't feed into `argv-c`; it's a standalone step you run first to
# populate a databaseDir for the pipeline to later read as input.
#
# Run `python3 src/download/Downloader.py src/download/downloader.config`
# from the repo root (relative paths below are resolved from there).

[File Locations]
# CSV listing repos, see dataset.csv at the repo root
csv=repos.csv
# Download destination
databaseDir=repos

[Downloader]
projectCount = 15

# Everything below is a CSV column filter: each key must match a column in
# the CSV named by [File Locations].csv; unknown keys abort the download. A
# value that parses as a number is treated as a MINIMUM (row's column value
# must be >=); otherwise it's a SELECTION (comma-separated list of
# acceptable exact-match values, e.g. `language = C,C++`).
language = C
size = 100
# stars = 0
